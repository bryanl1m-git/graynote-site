---
import Icon from './Icon.astro';

interface Props {
  variant?: 'home' | 'bryan';
}

const { variant = 'home' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="tab">
    <img src="/svg/graynote-labs-light.svg" alt="Graynote Labs" width="120" height="28" />
    <div class="meta">
      {
        variant === 'home' ? (
          <a href="mailto:bryan.lim@graynote.io">bryan.lim@graynote.io</a>
        ) : (
          <a class="visit" href="https://graynote.io/">Visit graynote.io <Icon name="arrow-right" /></a>
        )
      }
      <span>© {year} Graynote Labs</span>
    </div>
  </div>
</footer>
